# MongoDB
MONGODB_URI=mongodb://mongodb:27017/chokmoki
MONGODB_DB_NAME=chokmoki

# Redis
REDIS_URL=redis://redis:6379/0

# Auth
JWT_SECRET=chokmoki-super-secret-jwt-key-change-in-prod

# Super admin login (used by /admin panel — change for production)
ADMIN_EMAIL=admin@chokmoki.com
ADMIN_PASSWORD=admin123

# Razorpay (optional for local dev)
RAZORPAY_KEY_ID=rzp_test_dummy
RAZORPAY_KEY_SECRET=dummy_secret
RAZORPAY_WEBHOOK_SECRET=

# Telegram (optional)
TELEGRAM_ENABLED=false
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# R2 / Cloudflare
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET=amplify-checkout
R2_KEY_PREFIX=chokmoki
R2_PUBLIC_BASE_URL=https://cdn.amplifycheckout.com

# Logging
LOG_LEVEL=INFO

# Rate Limiting
RATE_LIMIT_ENABLED=true
