# MongoDB
MONGODB_URI=mongodb://mongodb:27017/chokmoki
MONGODB_DB_NAME=chokmoki

# Redis
REDIS_URL=redis://redis:6379/0

# Auth — use scripts/generate_admin_password_hash.py for ADMIN_PASSWORD_HASH
JWT_SECRET=replace-with-openssl-rand-hex-32-or-longer
ADMIN_EMAIL=admin@chokmoki.com
ADMIN_PASSWORD=replace-with-local-dev-password
ADMIN_PASSWORD_HASH=

# Razorpay (optional for local dev)
RAZORPAY_KEY_ID=rzp_test_dummy
RAZORPAY_KEY_SECRET=replace-with-razorpay-test-secret
RAZORPAY_WEBHOOK_SECRET=

# Telegram (optional)
TELEGRAM_ENABLED=false
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# R2 / Cloudflare — inject via deployment secrets only
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET=chokmoki
R2_KEY_PREFIX=
R2_PUBLIC_BASE_URL=

# Logging
LOG_LEVEL=INFO

# Rate Limiting
RATE_LIMIT_ENABLED=true

# Client IP / proxy trust (LOCAL DEV ONLY — validation forbids XFF trust in production)
# Behind nginx set X-Real-IP and prefer RATE_LIMIT_IP_HEADER instead of trusting raw XFF.
TRUSTED_PROXY_ENABLED=true
TRUST_X_FORWARDED_FOR=true
# Temporary: dump request headers + resolved client IP for auth paths to stdout
LOG_CLIENT_IP_HEADERS=true
